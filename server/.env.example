PORT=3000

# From your Spotify Developer Dashboard app
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here

# Must exactly match the redirect URI registered in your Spotify app settings.
# Note the /auth/callback path — add this exact URL in your Spotify app.
SPOTIFY_REDIRECT_URI=http://localhost:3000/auth/callback

# Random secret used to sign session cookies — generate with: openssl rand -hex 32
SESSION_SECRET=change_me_to_a_random_secret

# URL of the frontend — used for CORS and post-OAuth redirects
CLIENT_ORIGIN=http://localhost:5173
